---
const { agent, id, slot = 1, speech } = Astro.props;
const icons: Record<string,string> = {
 gumdrop:'M8 4L3 8l5 4M12 4l5 4-5 4M11 2L9 14',
 round:'M13 12l4 4M13 7a5 5 0 1 1-10 0 5 5 0 0 1 10 0',
 cookie:'M4 8l4 4 8-8',
 icecream:'M3 3h14v12H3zM3 6h14M7 3l2 3M12 3l2 3M8 9l4 2-4 2z',
 floss:'M4 2h9l3 3v11H4zM12 2v4h4M7 9h6M7 12h5',
 sprinkle:'M3 5h14M3 12h14M7 3v4M13 10v4',
 lollipop:'M4 14l1-4L13 2l3 3-8 8-4 1zM11 4l3 3',
 softserve:'M3 3h14v12H3zM3 7h14M8 7v8',
};
---
<div class={`journey-agent ${speech ? "speaking-agent" : ""}`} style={`grid-column:${(slot-1)%3+1};grid-row:${Math.floor((slot-1)/3)+1}`}>
  {speech ? <><div class="agent-trigger"><img src={`/avatars/${agent.shape}.svg`} alt={agent.name} width="56" height="62"/></div><p class="agent-speech">{speech}</p></> : <>
  <button class="agent-trigger" aria-label={agent.name} aria-expanded="false" aria-controls={`job-${id}`}><img src={`/avatars/${agent.shape}.svg`} alt="" width="56" height="62" loading="lazy"/><span class="role-symbol" aria-hidden="true"><svg viewBox="0 0 20 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={icons[agent.shape] ?? 'M10 2l7 7-7 7-7-7z'}/></svg></span></button>
  <div class="agent-popover" id={`job-${id}`} role="region" aria-label={`${agent.name} job`}><strong>{agent.name}</strong><p>{agent.job}</p></div>
  </>}
</div>
