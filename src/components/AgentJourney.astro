.journey-path{gap:0 56px;isolation:isolate;padding:12px 0}.journey-step{border:0;background:transparent;padding:24px 18px 28px 42px;min-height:250px;border-top:2px dashed #d8bda7;border-radius:0}.journey-step:nth-of-type(1){grid-column:1;grid-row:1}.journey-step:nth-of-type(2){grid-column:2;grid-row:1;border-right:2px dashed #d8bda7;border-radius:0 38px 38px 0}.journey-step:nth-of-type(3){grid-column:2;grid-row:2}.journey-step:nth-of-type(4){grid-column:1;grid-row:2;border-left:2px dashed #d8bda7;border-radius:38px 0 0 38px}.journey-step:nth-of-type(5){grid-column:1;grid-row:3}.journey-step:nth-of-type(6){grid-column:2;grid-row:3}.journey-step:nth-of-type(odd)::before{content:'';position:absolute;top:-2px;left:100%;width:56px;border-top:2px dashed #d8bda7}.journey-step:nth-of-type(3)::before{left:auto;right:100%}.journey-number{position:absolute;top:-16px;left:38px;border:4px solid #fbf7f0;width:32px;height:32px;font-size:10px;float:none;margin:0}.journey-step-copy h3{margin-top:8px}.journey-agents{gap:12px;margin-top:16px}.journey-agent{width:68px}.agent-trigger{width:64px;height:64px;border-radius:50%;background:#f4e8dc;border:1px solid #e4cdbb;padding:4px;box-shadow:0 3px 0 #e7d9cd;position:relative}.agent-trigger img{width:48px;height:53px}.agent-trigger span{position:absolute;top:70px;width:90px;font-size:9px;font-weight:500;max-width:90px}.journey-agent{margin-bottom:22px}.journey-agent.is-open .agent-trigger{border-color:#bd7894;background:#f8dfeb;box-shadow:0 0 0 3px #ead0dc}.agent-popover{border:1px solid #604656;box-shadow:0 12px 35px #352c3533}.agent-popover strong{font-size:15px}.agent-popover p{font-size:13px}.journey-footnote{margin-top:6px}
