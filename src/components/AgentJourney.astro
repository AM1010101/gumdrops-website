---
import AgentBubble from './AgentBubble.astro';
const stages = [
  {title:'Create your first agent',copy:'Start with one job you know well. Give your agent a clear role, a workspace and an example of a useful result.', agents:[{shape:'gumdrop',name:'Code reviewer',job:'Read a diff, check it against the project conventions and report concrete issues with file references. You decide which fixes to make.'}]},
  {title:'Add more as you need',copy:'Keep responsibilities separate. A second agent brings a different brief and its own memory.',agents:[{shape:'round',name:'Competitor watcher',job:'Check named competitors on a schedule. Record what changed, link to sources and explain what may matter for your product. Needs web access through your chosen tools.'},{shape:'cookie',name:'Issue triager',job:'Review new issues, identify duplicates, ask for missing reproduction details and suggest priorities for the project.'}]},
  {title:'Start a second project',copy:'Put agents in a second project’s .gumdrops/agents/ folder. Give them that project’s workspace, tools and instructions.',agents:[{shape:'icecream',name:'Video assistant',job:'With a local video tool such as FFmpeg installed, prepare clips, convert formats and assemble draft cuts from your brief. Review the exported video yourself.'},{shape:'floss',name:'Research assistant',job:'Gather source material, keep references and write a concise brief. Store useful findings in memory for the next run.'}]},
  {title:'Turn a good agent into a template',copy:'Once its instructions work, keep a reusable copy of the agent folder. Keep the role and skills; remove project-specific memory and check tool settings.',agents:[{shape:'gumdrop',name:'Code reviewer',job:'Save the code reviewer from your first project as a reusable folder. Keep its review rules and skills, then remove project-specific memory before copying it.'}]},
  {title:'Reuse it across your projects',copy:'Copy the template into each project and adjust its workspace, permissions and schedule. Each copy develops its own memory. Template changes do not automatically update copies.',agents:[{shape:'gumdrop',name:'Reviewer · Coding project',job:'The same code-review template, configured for Coding project. It uses this project’s conventions, workspace and test commands.'},{shape:'gumdrop',name:'Reviewer · Video project',job:'Another copy of the same reviewer in Video project. Its role stays consistent, while its workspace, project instructions and memory are separate.'}]},
  {title:'Grow your agent teams',copy:'Refine roles from real results. Keep what works, tighten the briefs and add schedules where they help. Build a team around your workflow, one useful job at a time.',agents:[{shape:'sprinkle',name:'Workflow maintainer',job:'Review recurring work, identify missed steps and propose changes to agent instructions. You approve changes that affect the team’s responsibilities.'},{shape:'lollipop',name:'Content assistant',job:'Draft release notes, scripts and product updates from your source material. Follow your voice and leave publication to you.'},{shape:'softserve',name:'Design reviewer',job:'With screenshot or browser tools configured, review interfaces for clarity, consistency and mobile usability. Describe specific changes to consider.'},{shape:'bean',name:'Your next specialist',job:'Choose the repetitive job that still takes your time. Give it a narrow brief, the tools it needs and a clear way to judge the result.'}]},
];
const reviewer = stages[0].agents[0];
const reusableAgent = stages[1].agents[0];
const projectA = [reviewer, ...stages[1].agents];
const projectB = stages[2].agents;
const slotFor = (shape: string) => ({gumdrop:1, round:2, cookie:3, icecream:2, floss:3, sprinkle:4, lollipop:4, softserve:5}[shape] ?? 6);
const groups = [
  [{label:'Coding project',agents:[reviewer]}],
  [{label:'Coding project',agents:projectA}],
  [{label:'Coding project',agents:projectA},{label:'Video project',agents:projectB}],
  [{label:'Reusable template',agents:[reviewer],template:true}],
  [{label:'Coding project',agents:[reusableAgent]},{label:'Video project',agents:[reusableAgent]}],
  [{label:'Coding project',agents:[...projectA,stages[5].agents[0],stages[5].agents[2]]},{label:'Video project',agents:[...stages[1].agents,...projectB,stages[5].agents[1]]}],
];

// Combine template creation and reuse into one step, retaining the copying scene.
stages[4].title = 'Create reusable templates';
stages[4].copy = 'Keep a reusable copy of a proven agent folder. Remove project-specific memory, then copy it into each project and adjust its workspace, tools and schedule. Each copy keeps its own memory.';
stages.splice(3, 1);
groups.splice(3, 1);
stages.splice(2, 1);
groups.splice(2, 1);

---
<section class="agent-journey" id="journey" aria-labelledby="journey-title">
  <div class="journey-heading"><h2 id="journey-title">Build your team, one agent at a time</h2></div>
  <ol class="journey-path">
    <svg class="journey-route" aria-hidden="true" preserveAspectRatio="none"><path class="route-line" fill="none"/></svg>
    {stages.map((stage,index) => <li class="journey-step">
      <span class="journey-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
      <div class="journey-step-copy"><h3>{stage.title}</h3><div class="journey-agent step-info"><button class="agent-trigger info-trigger" aria-label={`About step ${index + 1}: ${stage.title}`} aria-expanded="false" aria-controls={`step-info-${index}`}><span aria-hidden="true">i</span></button><div class="agent-popover" id={`step-info-${index}`} role="region" aria-label={stage.title}><strong>{stage.title}</strong><p>{stage.copy}</p></div></div></div>
      <div class={`journey-scene scene-${index >= 2 ? index + 2 : index}`}>
        {index === 2 && <div class="copy-source" aria-hidden="true"><div class="copy-template"><img src="/avatars/round.svg" width="48" height="53"/></div><svg class="copy-branches" viewBox="0 0 400 46" fill="none"><path d="M200 0V13M200 13H100V40M200 13H300V40" stroke="currentColor" stroke-width="1.7"/><path d="M95 34L100 40L105 34M295 34L300 40L305 34" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></div>}
        {groups[index].map((group,groupIndex) => <div class={`project-folder ${group.label === 'Video project' ? 'project-b' : 'project-a'} ${'template' in group ? 'template-stack' : ''}`}>
          <span class="folder-tab">{group.label}</span>
          <div class="journey-agents">{group.agents.map((agent,agentIndex) => <AgentBubble agent={agent} id={`${index}-${groupIndex}-${agentIndex}`} slot={index === 2 ? 1 : index === 3 && groupIndex === 1 ? agentIndex + 1 : slotFor(agent.shape)} speech={index === 0 ? 'I do code review.' : index === 1 && agent.shape === 'round' ? 'I track competitor updates.' : index === 1 && agent.shape === 'cookie' ? 'I triage issues.' : undefined}/>)}
          {index === 3 && groupIndex === 1 && <div class="journey-agent" style="grid-column:3;grid-row:2"><button class="agent-trigger add-agent" aria-label="Explore your next specialist" aria-expanded="false" aria-controls="job-next">+</button><div class="agent-popover" id="job-next" role="region" aria-label="Your next specialist"><strong>Your next specialist</strong><p>Choose the repetitive job that still takes your time. Give it a focused brief and the tools it needs.</p></div></div>}</div>
        </div>)}
      </div>
    </li>)}
  </ol>
</section>
<script>
const route = document.querySelector<SVGSVGElement>('.journey-route');
const journey = document.querySelector<HTMLElement>('.journey-path');
function drawRoute() {
  if (!route || !journey) return;
  const steps = journey.querySelectorAll<HTMLElement>('.journey-step');
  const box = journey.getBoundingClientRect();
  const width = box.width;
  const mobile = window.matchMedia('(max-width:760px)').matches;
  const first = steps[0].getBoundingClientRect();
  const third = steps[2].getBoundingClientRect();
  const fourth = steps[3].getBoundingClientRect();
  const y1 = first.top - box.top;
  const y2 = third.top - box.top;
  const y3 = fourth.top - box.top;
  route.setAttribute('viewBox', `0 0 ${width} ${box.height}`);
  let path;
  if (mobile) {
    const x = 11;
    path = `M${x} 18V${box.height - 28}`;
  } else {
    const right = width - 1, radius = 32, mid = (y1 + y2) / 2;
    path = `M0 ${y1}H${right - radius}Q${right} ${y1} ${right} ${y1 + radius}V${y2 - radius}Q${right} ${y2} ${right - radius} ${y2}H${radius}Q0 ${y2} 0 ${y2 + radius}V${y3 - radius}Q0 ${y3} ${radius} ${y3}H${right}`;
  }
  route.querySelector('.route-line')!.setAttribute('d', path);

}
if (journey) new ResizeObserver(drawRoute).observe(journey);
window.addEventListener('resize', drawRoute);
drawRoute();
const agents = Array.from(document.querySelectorAll<HTMLElement>('.journey-agent'));
function closeAll(except?: HTMLElement) {
  agents.forEach(agent => { if (agent !== except) { agent.classList.remove('is-open'); agent.querySelector('button')?.setAttribute('aria-expanded', 'false'); } });
}
agents.forEach(agent => {
  const button = agent.querySelector('button');
  const panel = agent.querySelector<HTMLElement>('.agent-popover');
  if (!button || !panel) return;
  function place() {
    const rect = button.getBoundingClientRect();
    panel.style.position = 'fixed'; panel.style.bottom = 'auto'; panel.style.right = 'auto';
    panel.style.left = `${Math.max(12, Math.min(rect.left, window.innerWidth - panel.offsetWidth - 12))}px`;
    panel.style.top = `${rect.top > panel.offsetHeight + 20 ? rect.top - panel.offsetHeight - 10 : rect.bottom + 10}px`;
  }
  button.addEventListener('pointerenter', place);
  button.addEventListener('focus', place);
  button.addEventListener('click', place);
  window.addEventListener('scroll', place, { passive: true });
  window.addEventListener('resize', place);
  button.addEventListener('click', () => {
    const open = !agent.classList.contains('is-open'); closeAll();
    agent.classList.toggle('is-open', open); button.setAttribute('aria-expanded', String(open));
  });

  agent.addEventListener('pointerleave', () => { if (!agent.classList.contains('is-open')) button.setAttribute('aria-expanded', 'false'); });

  button.addEventListener('blur', () => { if (!agent.classList.contains('is-open')) button.setAttribute('aria-expanded', 'false'); });
});
document.addEventListener('click', event => { if (!(event.target as Element).closest('.journey-agent')) closeAll(); });
document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeAll(); const active = document.activeElement as HTMLElement; active?.blur(); } });
</script>
<style is:global>
