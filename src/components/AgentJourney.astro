height:41px}.scene-4{width:348px}.scene-4 .project-folder .journey-agents{grid-template-rows:46px}.template-stack{width:76px}.template-stack .journey-agents{grid-template-columns:46px;grid-template-rows:46px}}
@media(max-width:760px){.project-folder{width:calc(50% - 4px);padding:12px 6px 8px}.project-folder .journey-agents{grid-template-columns:repeat(2,44px);grid-template-rows:repeat(3,44px);gap:5px}.project-folder .journey-agent{width:44px;grid-column:auto!important;grid-row:auto!important}.project-folder .agent-trigger{width:42px;height:42px}.project-folder .agent-trigger img{width:35px;height:39px}.journey-scene{width:100%;gap:8px}.template-stack{width:76px}.template-stack .journey-agents{grid-template-columns:44px;grid-template-rows:44px}.scene-4 .project-folder .journey-agents{grid-template-rows:44px}.journey-step{min-height:0}}

/* Five stops after combining template creation and reuse. */
.journey-step:nth-of-type(5){grid-column:1 / -1;grid-row:3}.journey-step:nth-of-type(5)::before{display:none}.journey-step:nth-of-type(5) .journey-scene{max-width:520px}.journey-step:nth-of-type(5) .project-folder{width:240px}.journey-step:nth-of-type(5) .project-folder .journey-agents{max-width:none}@media(max-width:760px){.journey-step:nth-of-type(5) .project-folder{width:calc(50% - 4px)}}

/* Four stops: first agent, more roles, reuse, assembled team. */
