:visible;opacity:1;pointer-events:auto}.journey-agent:last-child .agent-popover{left:auto;right:0}.journey-agent:last-child .agent-popover::after{left:auto;right:32px}.journey-footnote{font-size:11px;color:#85787c;margin:18px 0 0;max-width:850px}@media(max-width:760px){.agent-journey{padding:40px 24px}.journey-heading{display:block}.journey-heading h2{font-size:30px}.journey-heading>p{max-width:100%}.journey-path{grid-template-columns:1fr;gap:12px}.journey-step{padding:16px}.journey-agents{gap:4px}.journey-agent{width:70px}.agent-trigger span{font-size:9px}.agent-popover{width:235px}.journey-agent:nth-child(n+3) .agent-popover{left:auto;right:0}.journey-agent:nth-child(n+3) .agent-popover::after{left:auto;right:25px}}@media(prefers-reduced-motion:reduce){.agent-trigger img,.agent-popover{transition:none}.agent-trigger:hover img{transform:none}}

