---
import stories from '../data/stories.json';
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Persistent coding agents on your computer. Editable files, scheduled work and Git history. Open-source Gum Drops." /><title>Gum Drops · Agents with a place to call home</title></head>
<body>
  <header><a class="brand" href="/">Gum Drops<span class="brand-dot"></span></a><nav aria-label="Main"><a href="#how">How it works</a><a href="#stories">Stories</a><a href="https://github.com/AM1010101/gum-drops">GitHub ↗</a></nav></header>
  <main>
    <section class="hero"><div><p class="eyebrow">Open source. Runs on your computer.</p><h1>A little agent.<br />An ongoing job.</h1><p class="intro">Give a coding agent a role, a memory and a schedule. Gum Drops keeps it running, with conversations you can return to and files you can edit.</p><div class="actions"><a class="button" href="#install">Get started</a><a href="https://github.com/AM1010101/gum-drops">Read the source ↗</a></div><p class="small">macOS & Linux · Built on Pi · Bring your model provider</p></div><div class="hero-art" aria-hidden="true"><svg viewBox="0 0 300 300"><defs><radialGradient id="candy" cx=".3" cy=".2" r=".85"><stop stop-color="#ffbfcf"/><stop offset=".5" stop-color="#ee6c91"/><stop offset="1" stop-color="#be3f69"/></radialGradient></defs><ellipse cx="150" cy="259" rx="85" ry="9" fill="#ddc9be" opacity=".4"/><g class="character"><path d="M190 55 C243 62 260 105 228 136 C204 157 203 169 222 190 C257 231 203 266 149 254 C87 245 40 202 46 145 C50 87 120 40 190 55Z" fill="url(#candy)"/><path d="M74 101 Q94 65 127 73 Q142 81 114 90 Q87 112 74 101" fill="#ffe7ec"/><rect x="116" y="150" width="15" height="31" rx="7.5" fill="#352638"/><rect x="165" y="150" width="15" height="31" rx="7.5" fill="#352638"/></g></svg><span class="art-note">A character for every agent.</span></div></section>
    <section class="principles" id="how"><p class="eyebrow">Built for work that continues</p><h2>Your agents have a home.<br />You hold the keys.</h2><div class="columns"><article><span>01</span><h3>Files you can change</h3><p>An agent is a folder with an <code>AGENT.md</code> and a <code>memory.md</code>. Read its instructions, edit its memory and version them with Git.</p></article><article><span>02</span><h3>Work between visits</h3><p>The host runs in the background when you close the browser. Agents keep an ongoing conversation, split work into threads and run on a schedule.</p></article><article><span>03</span><h3>A record of each run</h3><p>Gum Drops snapshots runs on Git refs. Inspect and revert changes through the host and CLI. Questions that need you collect in the UI.</p></article></div></section>
    <section id="stories" class="stories"><div class="section-heading"><div><p class="eyebrow">Help shape the next release</p><h2>What should we build next?</h2></div><p>Help choose what we build next. Open a story on GitHub, sign in and add a thumbs-up reaction.</p></div><div class="columns">{stories.map(story => <article class="story"><p class="eyebrow">{story.category}</p><h3>{story.title}</h3><p>{story.description}</p><a class="story-vote" href={story.url}>View issue & vote ↗</a></article>)}</div><p class="small">Votes are GitHub thumbs-up reactions. A GitHub account is required. You can also comment or contribute a fix.</p></section>
    <section id="install" class="install"><div><p class="eyebrow">Start with one agent</p><h2>Give it a job.<br />See what sticks.</h2><p>You need Node.js 22.19 or later and access to a model provider. Setup registers the background host and opens the UI.</p></div><div><pre><code>npm i -g gumdrops
gumdrops setup</code></pre><a href="https://github.com/AM1010101/gum-drops#install">Installation & documentation ↗</a></div></section>
  </main><footer><span>Gum Drops · Open source</span><a href="https://github.com/AM1010101/gum-drops">Code, issues & contributions ↗</a></footer>

<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fbf7f0;color:#342c33;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}header,main,footer{max-width:1200px;margin:auto}header{padding:32px 40px;display:flex;justify-content:space-between;align-items:center}.brand{font-family:'Trebuchet MS',sans-serif;font-size:23px;font-weight:800;display:flex;align-items:center;gap:8px}.brand-dot{width:10px;height:10px;border-radius:50%;background:#e6638a}nav{display:flex;gap:28px;font-size:14px}.hero{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;padding:65px 40px 95px;gap:40px}.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:11px;font-weight:700;color:#947565}h1,h2,h3{font-family:'Trebuchet MS',sans-serif;line-height:1.1;letter-spacing:-2px}h1{font-size:clamp(44px,6vw,76px);margin:24px 0}h2{font-size:44px;margin:16px 0 40px}h3{font-size:22px;letter-spacing:-.6px;line-height:1.25}.intro{font-size:18px;max-width:510px;color:#74676b}.actions{display:flex;align-items:center;gap:24px;margin:30px 0}.button{background:#3c303b;color:#fff;padding:13px 23px;border-radius:8px;font-size:14px}.small{font-size:12px;color:#85787c}.hero-art{background:#f5e8dc;border-radius:48% 48% 38% 38%;padding:38px;position:relative;text-align:center}.hero-art svg{width:100%;max-width:350px}.art-note{display:block;font-size:12px;color:#8a6d74}.character{transform-origin:150px 254px;animation:breathe 6s ease-in-out infinite}@keyframes breathe{50%{transform:rotate(3deg) scale(1.01,.99)}}section{scroll-margin-top:24px}.principles{padding:70px 40px;border-top:1px solid #e5dcd4}.columns{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.columns p{font-size:15px;color:#786b70}.columns article>span{color:#bd9484;font-size:12px}.stories{padding:60px 40px;background:#f2ebe3;border-radius:20px}.section-heading{display:flex;justify-content:space-between;gap:36px}.section-heading>p{max-width:310px;color:#786b70;font-size:14px}.story{display:flex;flex-direction:column;background:#fffaf4;padding:26px;border-radius:12px;border:1px solid #e9ddd3}.story>p:not(.eyebrow){flex:1}.story-vote{align-self:flex-start;background:transparent;border:1px solid #d6bdb3;border-radius:7px;padding:9px 14px;color:#573e49;cursor:pointer;font:inherit;font-size:13px}.count{margin-left:14px}.story-vote:hover{background:#f8e1e8}.story-vote:disabled{opacity:.7;cursor:default}.install{padding:95px 40px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.install p{max-width:430px;color:#786b70}pre{background:#352c35;color:#fae9d6;border-radius:12px;padding:26px;line-height:2;overflow:auto}code{font-family:monospace}footer{padding:28px 40px;border-top:1px solid #e5dcd4;font-size:12px;color:#85787c;display:flex;justify-content:space-between}a:focus-visible,button:focus-visible{outline:3px solid #be4270;outline-offset:5px}@media(max-width:760px){header{padding:24px}nav{gap:14px;font-size:12px}nav a:first-child{display:none}.hero{grid-template-columns:1fr;padding:36px 24px 60px}.hero-art{max-width:360px;width:100%;margin:auto}.columns{grid-template-columns:1fr}h2{font-size:34px}.principles,.stories{padding:40px 24px}.stories{border-radius:0}.section-heading{display:block}.install{grid-template-columns:1fr;padding:60px 24px;gap:10px}footer{padding:24px;gap:24px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.character{animation:none}}
</style>
</body></html>
